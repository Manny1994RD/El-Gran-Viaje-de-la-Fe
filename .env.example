# Copy this file to .env and fill it in.

# One-time code you type on the site ("Tengo un código") to create the administrator.
# Pick anything (letters/numbers). It stops working once the admin exists.
SETUP_CODE=CAMBIA-ESTE-CODIGO

# Token from Cloudflare Zero Trust > Networks > Tunnels (see README).
TUNNEL_TOKEN=

# Port on the NAS for home-network access (http://NAS-IP:8080)
PORT=8080

# Your time zone (used for "today" and weekly caps)
TZ=America/New_York
